PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/store?sslmode=disable
JWT_SECRET=change-me-in-production
FRONTEND_URL=http://localhost:5174
AUTO_SEED=true
DEFAULT_TAX_FEE=4.5
# Cria a conta de teste descrita em internal/database/seed_demo.go (login,
# endereco e senha prontos para testar o checkout). Mantenha false em producao:
# e uma conta com senha conhecida. O docker-compose.dev.yml liga sozinho.
SEED_DEMO_CUSTOMER=false
# Garantem a conta fixa de administrador (acesso ao Admin) em qualquer
# ambiente, inclusive producao. A cada boot do servidor, essa conta e criada
# ou tem a senha atualizada para o que estiver aqui - util tambem para
# recuperar o acesso caso alguem perca o admin por engano. Deixe as duas em
# branco para nao mexer em nada.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Client ID OAuth 2.0 do Google Cloud. E a unica variavel do login com Google:
# o frontend le este valor pela rota /api/store/config, entao trocar a
# credencial so pede restart do backend, sem rebuild. Enquanto estiver vazio o
# botao "Continuar com Google" fica desativado e o login por e-mail/CPF
# continua funcionando normalmente.
GOOGLE_CLIENT_ID=

# Envio de e-mail (usado hoje pelo link de "esqueci minha senha"). Sem isso a
# recuperacao de senha responde que esta indisponivel e manda o cliente falar
# com o atendimento. Ex. Gmail: smtp.gmail.com / 587 / senha de app.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Minha Loja
# So para desenvolvimento: imprime o link de recuperacao no log do servidor
# quando nao ha SMTP. NUNCA deixe true em producao - quem le o log troca a
# senha de qualquer cliente.
DEBUG_PASSWORD_RESET_LINK=false
